@model List<MVCResturang.Models.BookingAdminViewModel>
@{
    ViewData["Title"] = "Hantera Bokningar";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Hantera Bokningar</h1>
            <p class="text-muted">Visa, redigera eller ta bort bokningar</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Tillbaka
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Inga bokningar finns ännu.
        </div>
    }
    else
    {
        <!-- Filter knappar -->
        <div class="btn-group mb-3" role="group">
            <button type="button" class="btn btn-outline-primary active" onclick="showAll()">
                Alla (@Model.Count)
            </button>
            <button type="button" class="btn btn-outline-success" onclick="showUpcoming()">
                Kommande (@Model.Count(b => b.BookingTime >= DateTime.Now))
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="showPast()">
                Tidigare (@Model.Count(b => b.BookingTime < DateTime.Now))
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="bookingsTable">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Kund</th>
                        <th>Kontakt</th>
                        <th>Datum & Tid</th>
                        <th>Gäster</th>
                        <th>Bord</th>
                        <th>Status</th>
                        <th>Åtgärder</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        var isPast = booking.BookingTime < DateTime.Now;
                        var isToday = booking.BookingTime.Date == DateTime.Today;
                        var rowClass = isPast ? "table-secondary" : (isToday ? "table-warning" : "");

                        <tr class="@rowClass" data-booking-time="@booking.BookingTime.Ticks">
                            <td>@booking.Id</td>
                            <td>
                                <strong>@booking.CustomerName</strong>
                            </td>
                            <td>
                                <small>
                                    @if (!string.IsNullOrEmpty(booking.CustomerEmail))
                                    {
                                        <div><i class="bi bi-envelope"></i> @booking.CustomerEmail</div>
                                    }
                                    @if (!string.IsNullOrEmpty(booking.CustomerPhone))
                                    {
                                        <div><i class="bi bi-telephone"></i> @booking.CustomerPhone</div>
                                    }
                                </small>
                            </td>
                            <td>
                                <strong>@booking.BookingTime.ToString("yyyy-MM-dd")</strong><br/>
                                <small>@booking.BookingTime.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <span class="badge bg-info">@booking.NumberOfGuests gäster</span>
                            </td>
                            <td>
                                Bord <strong>@booking.TableNumber</strong><br/>
                                <small class="text-muted">(Plats för @booking.TableCapacity)</small>
                            </td>
                            <td>
                                @if (isPast)
                                {
                                    <span class="badge bg-secondary">Genomförd</span>
                                }
                                else if (isToday)
                                {
                                    <span class="badge bg-warning text-dark">Idag</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Kommande</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditBooking" asp-route-id="@booking.Id" 
                                       class="btn btn-sm btn-primary" title="Redigera">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteBooking" asp-route-id="@booking.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Är du säker på att du vill ta bort denna bokning för @booking.CustomerName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Ta bort">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted">Totalt antal bokningar: <strong>@Model.Count</strong></p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function showAll() {
            document.querySelectorAll('#bookingsTable tbody tr').forEach(row => {
                row.style.display = '';
            });
        }

        function showUpcoming() {
            const now = new Date().getTime() * 10000 + 621355968000000000; // Convert to .NET Ticks
            document.querySelectorAll('#bookingsTable tbody tr').forEach(row => {
                const bookingTime = parseInt(row.dataset.bookingTime);
                row.style.display = bookingTime >= now ? '' : 'none';
            });
        }

        function showPast() {
            const now = new Date().getTime() * 10000 + 621355968000000000;
            document.querySelectorAll('#bookingsTable tbody tr').forEach(row => {
                const bookingTime = parseInt(row.dataset.bookingTime);
                row.style.display = bookingTime < now ? '' : 'none';
            });
        }
    </script>
}