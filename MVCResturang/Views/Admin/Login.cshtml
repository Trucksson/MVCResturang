@model MVCResturang.Models.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-shield-lock"></i> Admin Inloggning
                </h2>

                <!-- Visa alla validerings-errors -->
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <form asp-action="Login" method="post">
                    <!-- Username field -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" placeholder="Ange användarnamn" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <!-- Password field -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Ange lösenord" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Submit button -->
                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-box-arrow-in-right"></i> Logga in
                    </button>

                    <!-- Back to home link -->
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link w-100">
                        Tillbaka till startsidan
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}  