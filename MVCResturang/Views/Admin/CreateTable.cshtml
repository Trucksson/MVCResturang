@model MVCResturang.Models.Table
@{
    ViewData["Title"] = "Lägg till nytt bord";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h2><i class="bi bi-plus-circle"></i> Lägg till nytt bord</h2>
                </div>
                <div class="card-body">
                    <form asp-action="CreateTable" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="TableNumber" class="form-label">Bordsnummer</label>
                            <input asp-for="TableNumber" class="form-control" type="number" min="1" 
                                   placeholder="T.ex. 1, 2, 3..." />
                            <span asp-validation-for="TableNumber" class="text-danger"></span>
                            <small class="form-text text-muted">Unikt nummer för bordet</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacity" class="form-label">Antal platser</label>
                            <input asp-for="Capacity" class="form-control" type="number" min="1" max="20" 
                                   placeholder="T.ex. 2, 4, 6..." />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                            <small class="form-text text-muted">Hur många gäster får plats vid bordet?</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-lightbulb"></i> 
                            <strong>Tips:</strong> Vanliga bordsstorlekar är 2, 4, 6 eller 8 platser.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Lägg till bord
                            </button>
                            <a asp-action="Tables" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Avbryt
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}