@model List<MVCResturang.Models.MenuItem>
@{
    ViewData["Title"] = "Hantera Meny";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Hantera Meny</h1>
            <p class="text-muted">Lägg till, redigera eller ta bort rätter från menyn</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="CreateMenuItem" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Lägg till ny rätt
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Tillbaka
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Inga rätter finns i menyn än. Klicka på "Lägg till ny rätt" för att börja.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px;">ID</th>
                        <th>Namn</th>
                        <th>Beskrivning</th>
                        <th>Pris</th>
                        <th>Populär</th>
                        <th style="width:140px;">Bild</th>
                        <th>Åtgärder</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                            <td>@item.Price kr</td>
                            <td>
                                @if (item.IsPopular)
                                {
                                    <span class="badge bg-success">Ja</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Nej</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BildUrl))
                                {
                                    <div class="image-box" title="@item.Description">
                                        <img src="@item.BildUrl" alt="@item.Name" />
                                        <div class="image-caption">@Html.Raw(System.Net.WebUtility.HtmlEncode(item.Description.Length > 60 ? item.Description.Substring(0,60) + "..." : item.Description))</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light rounded" style="width:120px; height:90px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                    <div><small class="text-muted">Ingen bild</small></div>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Admin actions">
                                    <a asp-action="EditMenuItem" asp-route-id="@item.Id" class="btn btn-outline-primary admin-action-btn" title="Redigera">
                                        <i class="bi bi-pencil me-1"></i> Redigera
                                    </a>

                                    <form asp-action="DeleteMenuItem" asp-route-id="@item.Id" method="post" class="d-inline" 
                                          onsubmit="return confirm('Är du säker på att du vill ta bort @item.Name?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger admin-action-btn" title="Ta bort">
                                            <i class="bi bi-trash me-1"></i> Ta bort
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted">Totalt antal rätter: <strong>@Model.Count</strong></p>
        </div>
    }
</div>

<style>
    /* Aspect-ratio box så bilden inte kläms/strecks — modern browsers stödjer aspect-ratio */
    .image-box {
        width: 120px;
        height: 90px;
        position: relative;
        overflow: hidden;
        border-radius: 6px;
        background: #f8f9fa;
        display: inline-block;
    }

    .image-box img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* bevarar proportioner utan att klämma */
        display: block;
    }

    .image-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: .25rem .5rem;
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        font-size: 0.75rem;
        line-height: 1;
        display: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .image-box:hover .image-caption {
        display: block;
    }

    /* Större admin-knappar med text */
    .admin-action-btn {
        padding: .45rem .8rem;
        font-size: .95rem;
        border-radius: .35rem;
    }

    .admin-action-btn i {
        vertical-align: -0.05em;
    }

    /* Små förbättringar för tabellens bilder på små skärmar */
    @@media (max-width: 576px) {
        .image-box {
            width: 80px;
            height: 60px;
        }
    }
</style>