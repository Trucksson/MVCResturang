@model MVCResturang.Models.BookingEditViewModel
@{
    ViewData["Title"] = "Redigera bokning";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2><i class="bi bi-pencil-square"></i> Redigera bokning</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Kund:</strong> @Model.CustomerName
                    </div>

                    <form asp-action="EditBooking" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" asp-for="CustomerName" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="BookingTime" class="form-label">Bokningsdatum och tid</label>
                            <input asp-for="BookingTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="BookingTime" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumberOfGuests" class="form-label">Antal gäster</label>
                                <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" max="20" />
                                <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TableId" class="form-label">Bord nummer</label>
                                <input asp-for="TableId" class="form-control" type="number" min="1" />
                                <span asp-validation-for="TableId" class="text-danger"></span>
                                <small class="form-text text-muted">Vilket bordsnummer ska användas</small>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Spara ändringar
                            </button>
                            <a asp-action="Bookings" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Avbryt
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Raderingssektion -->
            <div class="card mt-3 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Farlig zon</h5>
                </div>
                <div class="card-body">
                    <p>Om du vill ta bort denna bokning permanent:</p>
                    <form asp-action="DeleteBooking" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Är du SÄKER på att du vill ta bort denna bokning? Detta går inte att ångra!');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Ta bort bokning permanent
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}