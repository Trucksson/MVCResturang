@model List<MVCResturang.Models.MenuItem>
@{
    ViewData["Title"] = "Meny";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Meny</h1>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Inga rätter tillgängliga.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card menu-card h-100">
                        <div class="ratio ratio-4x3 position-relative">
                            @if (!string.IsNullOrEmpty(item.BildUrl))
                            {
                                <img src="@(item.BildUrl)" class="card-img-top w-100 h-100" alt="@item.Name" loading="lazy"
                                     onerror="this.src='/images/no-image.jpg';" />
                                <div class="card-img-overlay d-flex flex-column justify-content-end p-2 overlay-gradient">
                                    <h5 class="card-title text-white mb-0 text-shadow-sm">@item.Name</h5>
                                </div>
                            }
                            else
                            {
                                <div class="no-image-box d-flex align-items-center justify-content-center p-3">
                                    <div class="text-center">
                                        <h5 class="mb-2 fw-bold">@item.Name</h5>
                                        <p class="text-muted small mb-0">@((item.Description?.Length ?? 0) > 80 ? item.Description.Substring(0,80) + "…" : item.Description)</p>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Popular badge moved here (under image/placeholder) *@
                        @if (item.IsPopular)
                        {
                            <div class="popularity-badge text-center mt-2">
                                <span class="badge bg-warning text-dark">Populär</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            @* Description shown in card body for both types, trimmed *@
                            <p class="card-text text-muted mb-2">@((item.Description?.Length ?? 0) > 120 ? item.Description.Substring(0, 120) + "…" : item.Description)</p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div class="fs-6 fw-bold text-accent">@item.Price kr</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>